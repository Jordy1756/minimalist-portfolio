---
import Section from '@components/chrome/Section.astro';
import ExperienceCard from '@components/sections/experience/ExperienceCard.astro';
import { getCurrentLocale, useContentTranslations, useTranslations } from '@i18n/utils.ts';

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
const { experience } = useContentTranslations(currentLocale);
---

<Section title={t('experience.title')}>
  <div class="flex flex-col gap-4">
    {experience.map(({ name, position, startDate, endDate, highlights }) => (
      <ExperienceCard name={name} position={position} startDate={startDate} endDate={endDate} highlights={highlights} />
    ))}
  </div>
</Section>
