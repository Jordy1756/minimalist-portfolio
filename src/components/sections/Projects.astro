---
import Section from '@components/chrome/Section.astro';
import GithubIcon from '@components/icons/GithubIcon.astro';
import Link from '@components/ui/Link.astro';
import { getCurrentLocale, useContent, useTranslations } from '@i18n/utils.ts';

const currentLocale = getCurrentLocale(Astro.currentLocale);
const { sections, aria } = useTranslations(currentLocale);
const { projects } = useContent(currentLocale);
---

<Section title={sections.projects.title}>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(250px,1fr))] gap-4">
    {projects.map(({ name, description, url, github, stack }) => (
      <article class="flex min-h-43.75 flex-col gap-1 rounded-lg border border-neutral-200 p-4">
        <header class="flex items-center justify-between">
          <!-- <h3 class="flex text-lg font-bold text-neutral-800">
            {url ? (
              <Link
                href={url}
                class="flex items-center gap-2 hover:underline"
                title={aria('projects.card.project.aria', { name })}
                aria-label={t('projects.card.project.aria', name)}
              >
                {name}
              </Link>
            ) : (
              name
            )}
          </h3>
          <Link
            href={github}
            title={t('projects.card.github.aria', name)}
            aria-label={t('projects.card.github.aria', name)}
          >
            <GithubIcon
              width={20}
              height={20}
              class="flex items-center gap-2 text-neutral-700 transition-colors hover:text-neutral-900"
            />
          </Link> -->
        </header>
        <div class="mb-4 flex flex-1 flex-col gap-2">
          <p>{description}</p>
        </div>
        <footer>
          <ul class="flex flex-wrap gap-2 text-xs font-bold text-neutral-700">
            {stack.map((tech, index) => (
              <li class="flex gap-2">
                {index > 0 && <span>·</span>}
                <span>{tech}</span>
              </li>
            ))}
          </ul>
        </footer>
      </article>
    ))}
  </div>
</Section>
