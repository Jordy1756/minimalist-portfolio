---
import Section from '@components/chrome/Section.astro';
import ExternalIcon from '@components/icons/ExternalIcon.astro';
import GithubIcon from '@components/icons/GithubIcon.astro';
import Link from '@components/ui/Link.astro';
import { getCurrentLocale, useResume, useTranslations } from '@i18n/utils';

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
const { projects } = useResume(currentLocale);
---

<Section title={t('sections.projects.title')} class="print:hidden">
  <div class="grid grid-cols-[repeat(auto-fit,minmax(250px,1fr))] gap-4">
    {projects.map(({ name, description, url, github, stack }) => (
      <article class="flex min-h-43.75 flex-col gap-1 rounded-lg border p-4">
        <header class="flex items-center justify-between">
          {url ? (
            <Link
              href={url}
              class="flex items-center gap-2 text-lg font-bold text-neutral-800 hover:underline"
              aria-label={t('aria.project.demo', { name })}
            >
              {name}
              <ExternalIcon width={16} height={16} class="text-neutral-700" />
            </Link>
          ) : (
            <h3 class="text-lg font-bold text-neutral-800">{name}</h3>
          )}
          <Link href={github} aria-label={t('aria.project.repo', { name })}>
            <GithubIcon width={20} height={20} class="text-neutral-700 transition-colors hover:text-neutral-900" />
          </Link>
        </header>
        <div class="mb-4 flex flex-1 flex-col gap-2">
          <p>{description}</p>
        </div>
        <footer>
          <ul class="flex flex-wrap gap-2 text-xs font-bold text-neutral-700">
            {stack.map((tech, index) => (
              <li class="flex gap-2">
                {index > 0 && <span>·</span>}
                <span>{tech}</span>
              </li>
            ))}
          </ul>
        </footer>
      </article>
    ))}
  </div>
</Section>
