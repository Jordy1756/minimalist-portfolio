---
import Section from '@components/chrome/Section.astro';
import TimePeriod from '@components/ui/TimePeriod.astro';
import { getCurrentLocale, useResume, useTranslations } from '@i18n/utils';

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
const { education } = useResume(currentLocale);

const localeCode = currentLocale === 'es' ? 'es-ES' : 'en-US';
const presentText = t('labels.present');
---

<Section title={t('sections.education.title')}>
  {education.map(({ institution, area, startDate, endDate }) => (
    <article>
      <header>
        <header class="flex justify-between gap-2">
          <div class="flex flex-col">
            <h3 class="text-lg">{institution}</h3>
          </div>
          <TimePeriod startDate={startDate} endDate={endDate} localeCode={localeCode} presentText={presentText} />
        </header>
      </header>
      <div>
        <p>{area}</p>
      </div>
    </article>
  ))}
</Section>
