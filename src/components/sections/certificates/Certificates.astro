---
import Section from '@components/chrome/Section.astro';
import CertificateCard from '@components/sections/certificates/CertificateCard.astro';
import { getCurrentLocale, useResume, useTranslations } from '@i18n/utils';

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
const { certificates } = useResume(currentLocale);

const sortedYears = Object.keys(certificates)
  .map(Number)
  .sort((a, b) => b - a);
---

<Section title={t('sections.certificates.title')}>
  <div class="flex flex-col gap-8">
    {sortedYears.map((year) => (
      <div class="flex flex-col gap-2">
        <span class="font-bold text-neutral-950">{year}</span>
        <ul class="ml-4 flex flex-col gap-4">
          {certificates[year + ''].map(({ name, url, issuer, date }) => (
            <li class="relative gap-y-1 pl-4 before:absolute before:top-0 before:left-0 before:h-[calc(100%+16px)] before:w-px before:bg-neutral-200 after:absolute after:top-1/2 after:left-0 after:h-px after:w-3 after:bg-neutral-200 last:before:h-1/2">
              <CertificateCard name={name} url={url} issuer={issuer} date={date} />
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Section>
