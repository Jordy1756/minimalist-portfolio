---
import ExternalIcon from '@components/icons/ExternalIcon.astro';
import Link from '@components/ui/Link.astro';
import { getCurrentLocale, useTranslations } from '@i18n/utils';
import { getFormattedDate } from '@scripts/utils/handleDates';

interface Props {
  name: string;
  url: string;
  issuer: string;
  date: Date | null;
}

const { name, url, issuer, date } = Astro.props;

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);

const formattedDate = getFormattedDate(date, currentLocale === 'es' ? 'es-ES' : 'en-US', { month: 'short' });
const ariaLabel = t('aria.certificate', { name, issuer });
---

<article class="grid grid-cols-[30px_1fr] grid-rows-[auto_1fr] gap-x-4">
  <aside class="row-span-2 flex items-center">
    <time class="text-center text-xs text-nowrap text-neutral-500 uppercase" datetime={date + ''}>
      {formattedDate}
    </time>
  </aside>
  <header class="flex items-start justify-between gap-2">
    <h3 class="text-base">{name}</h3>
    <Link href={url} aria-label={ariaLabel} title={ariaLabel} target="_blank" rel="noopener noreferrer">
      <ExternalIcon width={20} height={20} class="size-5 transition-[color] hover:text-neutral-900" />
    </Link>
  </header>
  <div class="flex items-center justify-between gap-2">
    <p>{issuer}</p>
  </div>
</article>
