---
import Section from '@components/chrome/Section.astro';
import EducationCard from '@components/sections/education/EducationCard.astro';
import { getCurrentLocale, useContentTranslations, useTranslations } from '@i18n/utils.ts';

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
const { education } = useContentTranslations(currentLocale);
---

<Section title={t('education.title')}>
  {education.map(({ institution, area, startDate, endDate }) => (
    <EducationCard institution={institution} area={area} startDate={startDate} endDate={endDate} />
  ))}
</Section>
