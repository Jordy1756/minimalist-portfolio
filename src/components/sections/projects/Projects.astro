---
import Section from '@components/chrome/Section.astro';
import ProjectCard from '@components/sections/projects/ProjectCard.astro';
import { getCurrentLocale, useContentTranslations, useTranslations } from '@i18n/utils.ts';

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
const { projects } = useContentTranslations(currentLocale);
---

<Section title={t('projects.title')}>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(250px,1fr))] gap-4">
    {projects.map(({ name, description, url, github }) => (
      <ProjectCard name={name} description={description} url={url} github={github} />
    ))}
  </div>
</Section>
