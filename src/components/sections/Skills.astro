---
import Section from '@components/chrome/Section.astro';
import { getCurrentLocale, useContent, useTranslations } from '@i18n/utils.ts';

const currentLocale = getCurrentLocale(Astro.currentLocale);
const { sections } = useTranslations(currentLocale);
const { skills } = useContent(currentLocale);
---

<Section title={sections.skills.title}>
  <ul class="flex flex-wrap gap-2">
    {skills.map((skill) => (
      <li class="rounded-sm bg-neutral-800 px-4 py-1 text-center text-sm font-semibold text-neutral-50">{skill}</li>
    ))}
  </ul>
</Section>
