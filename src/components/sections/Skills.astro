---
import Section from '@components/chrome/Section.astro';
import { getCurrentLocale, useResume, useTranslations } from '@i18n/utils';

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
const { skills } = useResume(currentLocale);
---

<Section title={t('sections.skills.title')}>
  <ul class="flex flex-wrap gap-2">
    {skills.map((skill) => (
      <li class="rounded-sm bg-neutral-800 px-4 py-1 text-center text-sm font-semibold text-neutral-50">{skill}</li>
    ))}
  </ul>
</Section>
