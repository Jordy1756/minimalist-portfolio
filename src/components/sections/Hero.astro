---
import EmailIcon from '@components/icons/EmailIcon.astro';
import GithubIcon from '@components/icons/GithubIcon.astro';
import LinkedInIcon from '@components/icons/LinkedInIcon.astro';
import ResumeIcon from '@components/icons/ResumeIcon.astro';
import WorldIcon from '@components/icons/WorldIcon.astro';
import Link from '@components/ui/Link.astro';
import { getCurrentLocale, useResume, useTranslations } from '@i18n/utils';
import { Image } from 'astro:assets';

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
const { basics } = useResume(currentLocale);
const { name, label, email, location } = basics;

const heroLinks = [
  {
    href: `mailto:${email}`,
    icon: EmailIcon,
    ariaLabel: t('aria.hero.email', { name }),
  },
  {
    href: 'https://linkedin.com/in/yordicastro',
    icon: LinkedInIcon,
    ariaLabel: t('aria.hero.network', { name, network: 'LinkedIn' }),
  },
  {
    href: 'https://github.com/Jordy756',
    icon: GithubIcon,
    ariaLabel: t('aria.hero.network', { name, network: 'GitHub' }),
  },
  {
    href: `/docs/Yordi_Castro_CV_${currentLocale.toUpperCase()}.pdf`,
    icon: ResumeIcon,
    ariaLabel: t('aria.hero.resume', { name }),
  },
];
---

<header class="flex flex-col-reverse items-center justify-center gap-8 md:flex-row md:justify-between">
  <section class="flex flex-1 flex-col items-center gap-4 text-center md:items-start md:text-left">
    <div class="flex flex-col gap-2">
      <h1 class="text-3xl font-extrabold">{name}</h1>
      <h2 class="text-lg">{label}</h2>
      <address class="flex items-center justify-center gap-2 md:justify-start">
        <WorldIcon width={16} height={16} class="size-4" />
        <p class="not-italic">{`${location.city}, ${location.region}`}</p>
      </address>
    </div>
    <ul class="flex items-center justify-center gap-2 md:justify-start">
      {heroLinks.map(({ href, icon: Icon, ariaLabel }) => (
        <li class="rounded-sm border p-1">
          <Link href={href} aria-label={ariaLabel} title={ariaLabel} target="_blank" rel="noopener noreferrer">
            <Icon width={20} height={20} class="size-5 transition-[color] hover:text-neutral-900" />
          </Link>
        </li>
      ))}
    </ul>
  </section>
  <figure class="flex min-w-35">
    <Image
      src="/images/me.webp"
      alt={t('sections.hero.imageAlt')}
      class="aspect-auto h-62.5 w-auto rounded-sm object-cover md:max-h-43.5 md:flex-1"
      width={140}
      height={174}
    />
  </figure>
</header>
