---
import AboutMe from '@components/sections/AboutMe.astro';
import Certificates from '@components/sections/certificates/Certificates.astro';
import Education from '@components/sections/Education.astro';
import Experience from '@components/sections/Experience.astro';
import Hero from '@components/sections/Hero.astro';
import Projects from '@components/sections/Projects.astro';
import Skills from '@components/sections/Skills.astro';
import { getCurrentLocale, useTranslations } from '@i18n/utils.ts';
import Layout from '@layouts/Layout.astro';
export const getStaticPaths = async () => [{ params: { locale: 'en' } }, { params: { locale: 'es' } }];

const currentLocale = getCurrentLocale(Astro.currentLocale);
const { sections, meta } = useTranslations(currentLocale);
---

<Layout title={sections.hero.title} description={meta.description}>
  <Hero />
  <main class="flex flex-col gap-8">
    <AboutMe />
    <Experience />
    <Projects />
    <Education />
    <Certificates />
    <Skills />
  </main>
</Layout>
