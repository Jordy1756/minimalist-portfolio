---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getCurrentLocale, useTranslations } from '@i18n/utils';
import Layout from '@layouts/Layout.astro';

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
---

<Layout title={t('notFound.meta.title')} description={t('notFound.meta.description')}>
  <main class="flex flex-1 flex-col items-center justify-center text-center">
    <h1 class="text-8xl font-bold text-neutral-300 md:text-9xl">404</h1>
    <div class="flex flex-col items-center gap-2">
      <h2 class="text-2xl font-bold text-neutral-950">{t('notFound.title')}</h2>
      <p class="max-w-xs text-sm text-neutral-700">{t('notFound.description')}</p>
      <a
        href={getRelativeLocaleUrl(currentLocale, '')}
        class="rounded-sm border px-4 py-2 text-sm font-semibold transition-colors hover:bg-neutral-100 hover:text-neutral-950"
      >
        {t('notFound.back')}
      </a>
    </div>
  </main>
</Layout>
